.{
    .name = .jsz,
    .version = "0.1.0",
    .dependencies = .{
        // `upgrade/quickjsng-v0.17.0`: bundles QuickJS-ng 0.17.0, which marks
        // the internal module-evaluation promise handled after a top-level
        // throw. Without it, caught dynamic imports still report an unhandled
        // rejection.
        .quickjs = .{
            .url = "git+https://github.com/Inqnuam/zig-quickjs-ng#03e8a80e12ec0cfab2dff0e93c3594529c6b9911",
            .hash = "quickjs_ng-0.0.0-0cZnAw7TAwDJmVc37Q1FcLQhxKsv2ZM4Ha4mvIObzsmE",
        },
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#9b49086c72edbfbcef00acb557d6177bcaee1cb5",
            .hash = "zio-0.19.0-xHbVVHNqLQCbtzv2oAZp_8CRYKcc76Om5t697j-vFskK",
        },
        // Vendored from lalinsky/dusty v0.5.0 (48196c2d) with two local
        // patches: the response status line can carry a numeric code and a
        // caller-supplied reason phrase, and the client parser accepts codes
        // its Status enum does not name.
        .dusty = .{
            .path = "vendor/dusty",
        },
        .zig_webui = .{
            .url = "https://github.com/webui-dev/zig-webui/archive/e89087c3e9846d73c4d71865140d8a8ab64082b5.tar.gz",
            .hash = "zig_webui-2.5.1-M4z7zWPVAQA4GRBq-uS_aPAoxjFsR0hbpszpshwGX1Tf",
        },
    },
    .minimum_zig_version = "0.17.0",
    .paths = .{""},
    .fingerprint = 0xec325f3becd6a40,
}
